<templates xml:space="preserve">
    <t t-name="HelloWorld.TodoItem">
        <div class="p-4 bg-light h-100">
            <div style="max-width: 500px;">
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="card shadow-sm border-0 bg-info text-white text-center p-3">
                            <h3 class="mb-0"><t t-esc="state.draftCount"/></h3>
                            <small class="opacity-75">Borradores</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card shadow-sm border-0 bg-success text-white text-center p-3">
                            <h3 class="mb-0"><t t-esc="state.lockedCount"/></h3>
                            <small class="opacity-75">Bloqueados</small>
                        </div>
                    </div>
                </div>

                <div class="card shadow border-0">
                    <div class="card-body">
                        <h5 class="card-title d-flex justify-content-between align-items-center mb-3">
                            <span>Registros de <t t-esc="state.username"/></span>
                            <span class="badge rounded-pill bg-dark text-white"><t t-esc="state.records.length"/></span>
                        </h5>
                        
                        <div class="bg-white border rounded p-2 mb-3" style="max-height: 300px; overflow-y: auto;">
                            <p t-if="state.records.length === 0" class="text-center text-muted p-3">No hay registros.</p>
                            
                            <ul class="list-group list-group-flush">
                                <t t-foreach="state.records" t-as="record" t-key="record.id">
                                    <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-2">
                                        <div class="text-dark">
                                            <i t-attf-class="fa fa-circle me-2 {{record.state === 'locked' ? 'text-success' : 'text-info'}}" style="font-size: 10px;"></i>
                                            <a href="#" class="text-decoration-none text-dark fw-bold" t-on-click.prevent="() => this.openRecord(record.id)">
                                                <t t-esc="record.name"/>
                                            </a>
                                        </div>
                                        <button class="btn btn-link text-danger p-0" t-on-click="() => this.deleteRecord(record.id)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </li>
                                </t>
                            </ul>
                        </div>

                        <button class="btn btn-outline-primary w-100 fw-bold" t-on-click="finishTask">
                            <i class="fa fa-refresh me-2"></i> <t t-esc="state.status"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>