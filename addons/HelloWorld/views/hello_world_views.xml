<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sh_hello_world_tree" model="ir.ui.view">
        <field name="name">sh.hello.world.list</field>
        <field name="model">sh.hello.world</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'locked'">
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="category_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'locked'"/>
                <field name="user_phrase"/>
            </list>
        </field>
    </record>

    <record id="view_sh_hello_world_form" model="ir.ui.view">
        <field name="name">sh.hello.world.form</field>
        <field name="model">sh.hello.world</field>
        <field name="arch" type="xml">
            <form string="Hello World">
                <div class="o_form_sheet_bg" style="max-width: 100% !important; width: 100% !important;">
                    <header class="border-bottom mb-3 p-2 d-flex justify-content-between align-items-center" style="background: #f8f9fa;">
                        <div>
                            <button name="action_lock" string="Bloquear" type="object" class="btn-primary" invisible="state != 'draft'"/>
                            <button name="action_unlock" string="Desbloquear" type="object" class="btn-secondary" invisible="state != 'locked'"/>
                        </div>
                        <field name="state" widget="statusbar" statusbar_visible="draft,locked"/>
                    </header>

                    <sheet>
                        <div class="oe_title" style="max-width: 100% !important; width: 100% !important;">
                            <label for="name" string="Nombre del Registro"/>
                            <h1><field name="name" placeholder="Ej. Mi tarea..." readonly="state == 'locked'"/></h1>
                        </div>
                        <group>
                            <group string="Datos de Usuario">
                                <field name="user_id" readonly="state == 'locked'"/>
                                <field name="user_phrase" italic="1"/>
                            </group>
                            <group string="Configuración">
                                <field name="category_id" readonly="state == 'locked'"/>
                                <field name="tag_count"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción">
                                <field name="description_larga" readonly="state == 'locked'"/>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter" style="max-height: 450px; overflow-y: auto; background: white; margin-top: 20px; border-top: 1px solid #dee2e6;">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sh_hello_world" model="ir.actions.act_window">
        <field name="name">Registros Hello World</field>
        <field name="res_model">sh.hello.world</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_todo_owl" model="ir.actions.client">
        <field name="name">Mi Lista OWL</field>
        <field name="tag">hello_world.todo_action</field>
    </record>

    <menuitem id="menu_root" name="Hello World" sequence="10"/>
    
    <menuitem id="menu_main" 
              name="Registros" 
              parent="menu_root" 
              action="action_sh_hello_world" 
              sequence="10"/>

    <menuitem id="menu_todo_owl" 
              name="OWL Todo" 
              parent="menu_root" 
              action="action_todo_owl"
              sequence="20"/>

    <record id="view_sh_hello_world_search" model="ir.ui.view">
        <field name="name">sh.hello.world.search</field>
        <field name="model">sh.hello.world</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
            </search>
        </field>
    </record>
</odoo>