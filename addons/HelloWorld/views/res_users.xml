<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_frase" model="ir.ui.view">
        <field name="name">res.users.form.inherit.frase</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Información Extra" name="extra_info">
                    <group>
                        <field name="frase_personal" string="Mi Frase del Día" placeholder="Ej: El código es poesía..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>